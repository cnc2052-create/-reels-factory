# ══════════════════════════════════════════════════════
# 폼폼 PomPom 환경변수 — .env 로 복사 후 값을 채워 넣으세요
# ══════════════════════════════════════════════════════


# ────────────────────────────────
# [1] AI 엔진 (스크립트 자동 생성)
# ────────────────────────────────

# Anthropic API Key (폼폼 스크립트 생성에 사용)
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key (기존 시스템 호환용, 선택)
# 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...


# ────────────────────────────────
# [2] Buffer — 멀티계정 발행 스케줄러
# ────────────────────────────────
# 발급: https://buffer.com/developers/api → Create App → Access Token
# ※ 하나의 Access Token으로 모든 계정 제어 가능
BUFFER_ACCESS_TOKEN=...

# Buffer Profile ID — 계정별로 각각 다름
# 확인 방법:
#   curl "https://api.bufferapp.com/1/profiles.json?access_token=YOUR_TOKEN"
#   → 응답의 각 항목 "id" 값 복사
BUFFER_BEAUTY_ID=...     # 💄 뷰티폼 Instagram Profile ID
BUFFER_HEALTH_ID=...     # 💪 헬스폼 Instagram Profile ID
BUFFER_HOME_ID=...       # 🏠 홈폼 Instagram Profile ID
BUFFER_FASHION_ID=...    # 👗 패션폼 Instagram Profile ID
BUFFER_FOOD_ID=...       # 🍜 푸드폼 Instagram Profile ID

# (기존 단일 채널 호환용)
BUFFER_PROFILE_ID=...


# ────────────────────────────────
# [3] 쿠팡 파트너스 (제휴 링크 자동 생성)
# ────────────────────────────────
# 가입: https://partners.coupang.com
# → 내 정보 → 서브 ID 또는 추적 ID 확인
# 형식 예시: AF1234567
COUPANG_AFFILIATE_ID=AF...

# 쿠팡 파트너스 API (선택 — 제품 자동 검색용)
# → 파트너스 센터 → API 관리 → Access Key / Secret Key
COUPANG_ACCESS_KEY=...
COUPANG_SECRET_KEY=...


# ────────────────────────────────
# [4] 올리브영 제휴 (선택)
# ────────────────────────────────
# 가입: https://affiliate.oliveyoung.co.kr
# → 제휴 코드 확인
OLIVEYOUNG_AFFILIATE_ID=...


# ────────────────────────────────
# [5] Instagram (픽슬리 계정 — Meta Graph API)
# ────────────────────────────────
# 발급 순서:
# 1. https://developers.facebook.com → 앱 생성
# 2. Instagram Basic Display API 추가
# 3. 장기 액세스 토큰 발급 (60일 유효 → 재갱신 필요)
# 4. IG_USER_ID: GET /me?fields=id → id 값
IG_ACCESS_TOKEN=...
IG_USER_ID=...                    # 픽슬리 계정 숫자 ID


# ────────────────────────────────
# [6] TikTok (오늘의독템 — Content Posting API)
# ────────────────────────────────
# 발급: https://developers.tiktok.com → Content Posting API 승인 필요
# Login Kit → OAuth2 → Content Posting API
TIKTOK_ACCESS_TOKEN=...
TIKTOK_OPEN_ID=...                # TikTok 계정 open_id


# ────────────────────────────────
# [7] YouTube (오늘의독템 — Data API v3)
# ────────────────────────────────
# 발급: https://console.cloud.google.com → YouTube Data API v3 활성화
# → OAuth 2.0 클라이언트 ID → 새로고침 토큰 발급
YT_CLIENT_ID=...
YT_CLIENT_SECRET=...
YT_REFRESH_TOKEN=...              # 오늘의독템 채널 OAuth 토큰


# ────────────────────────────────
# [8] 쿠팡 파트너스 (shinsa16@naver.com 계정)
# ────────────────────────────────
# 가입: https://partners.coupang.com
COUPANG_ACCESS_KEY=...
COUPANG_SECRET_KEY=...


# ────────────────────────────────
# [9] 올리브영 제휴 (nonlovejjh 계정)
# ────────────────────────────────
# 가입: https://affiliate.oliveyoung.co.kr
OLIVEYOUNG_AFFILIATE_ID=...


# ────────────────────────────────
# [10] 노션 (콘텐츠 자동 저장)
# ────────────────────────────────
# 발급: https://www.notion.so/my-integrations → New integration → Secret
NOTION_TOKEN=secret_...
# DB ID: 노션 DB 페이지 URL에서 추출
# 예) notion.so/workspace/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx?v=...
#                         ↑ 이 32자리가 DB ID (하이픈 없이)
NOTION_DB_ID=...


# ────────────────────────────────
# [6] 발행 시각 (UTC 기준)
# ────────────────────────────────
# KST → UTC 변환: KST 시각 - 9
# 예) 뷰티폼 19:00 KST = 10:00 UTC
PUBLISH_HOUR_UTC=10
PUBLISH_MINUTE_UTC=0


# ────────────────────────────────
# [7] Pexels 무료 영상 (힉스필드 대신 사용)
# ────────────────────────────────
# 가입: https://www.pexels.com/api/ → 무료 API 키 발급 (상업용 무제한)
PEXELS_API_KEY=...


# ────────────────────────────────
# [8] 기타 설정
# ────────────────────────────────
CONTENT_CATEGORY=자기계발/동기부여
